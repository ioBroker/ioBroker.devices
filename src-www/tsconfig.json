// Specialized tsconfig for the www directory,
// includes DOM typings and configures the www build
{
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "useUnknownInCatchVariables": false,
        "strict": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "target": "ES2022",
        "paths": {
            "@iobroker/dm-widgets": ["../packages/dm-widgets/build/index.d.ts"],
            // The dm-widgets and src-admin sources are compiled as part of this project, but they
            // resolve their dependencies against their own node_modules. Pin the shared libraries to
            // this project's copies, otherwise React/MUI types are structurally identical but
            // nominally distinct.
            "@mui/material": ["./node_modules/@mui/material"],
            "@mui/material/*": ["./node_modules/@mui/material/*"],
            "@mui/icons-material": ["./node_modules/@mui/icons-material"],
            "@mui/icons-material/*": ["./node_modules/@mui/icons-material/*"],
            "@iobroker/gui-components": ["./node_modules/@iobroker/gui-components"],
            "@iobroker/type-detector": ["./node_modules/@iobroker/type-detector"]
        },
        "allowSyntheticDefaultImports": true,
        "checkJs": false,
        // Vite produces the bundle; tsc is only used to type check. Emitting here would race with
        // Vite's emptyOutDir and leave stray .js files in build/ that get shipped to www/.
        "noEmit": true,
        // src-www also type checks sources from ../packages/dm-widgets and ../src-admin, so the
        // implied rootDir (./src) would be too narrow. Nothing is written because of "noEmit".
        "rootDir": "..",
        "sourceMap": true,
        "sourceRoot": "./src",
        "noImplicitAny": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "lib": ["es2019", "DOM"],
        "jsx": "react",
        "types": ["@iobroker/types", "node"]
    },
    "include": ["./src/**/*.ts", "./src/**/*.d.ts", "./src/**/*.tsx", "./src/**/*.json", "./src/**/*.css"],
    "exclude": ["**/node_modules", "**/dist"]
}
