// Specialized tsconfig for the admin directory,
// includes DOM typings and configures the admin build
{
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        // This is necessary for the automatic typing of the adapter config
        "resolveJsonModule": true,
        "strict": true,
        "strictNullChecks": true,
        "useUnknownInCatchVariables": false,
        "target": "ES2022",
        "paths": {
            "@iobroker/dm-widgets": ["../packages/dm-widgets/build/index.d.ts"],
            // The dm-widgets sources are compiled as part of this project, but they resolve their
            // dependencies against packages/dm-widgets/node_modules. Pin the shared libraries to this
            // project's copies, otherwise React/MUI types are structurally identical but nominally distinct.
            "@mui/material": ["./node_modules/@mui/material"],
            "@mui/material/*": ["./node_modules/@mui/material/*"],
            "@mui/icons-material": ["./node_modules/@mui/icons-material"],
            "@mui/icons-material/*": ["./node_modules/@mui/icons-material/*"],
            "@iobroker/gui-components": ["./node_modules/@iobroker/gui-components"],
            "@iobroker/type-detector": ["./node_modules/@iobroker/type-detector"]
        },
        "allowSyntheticDefaultImports": true,
        "checkJs": false,
        // Vite produces the bundle; tsc is only used to type check. Emitting here would race with
        // Vite's emptyOutDir and leave stray .js files in build/ that get shipped to admin/.
        "noEmit": true,
        // src-admin also type checks sources from ../packages/dm-widgets and ../src, so the
        // implied rootDir (./src) would be too narrow. Nothing is written because of "noEmit".
        "rootDir": "..",
        "strictPropertyInitialization": true,
        "sourceMap": true,
        "sourceRoot": "./src",
        "noImplicitAny": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "lib": ["es2019", "DOM"],
        "jsx": "react",
        "types": ["@iobroker/types", "node"]
    },
    "include": ["./src/**/*.ts", "./src/**/*.d.ts", "./src/**/*.tsx", "./src/**/*.json", "./src/**/*.css"],
    "exclude": ["**/node_modules", "**/dist"]
}
